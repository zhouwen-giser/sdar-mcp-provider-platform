{
  "name": "@sdar/ugv-control-console",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "pnpm typecheck && vite build && tsc -p tsconfig.server.json",
    "start": "node build/server/main.js",
    "test": "vitest run --config vitest.config.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.90.5",
    "ajv": "8.18.0",
    "ajv-formats": "3.0.1",
    "fastify": "5.12.2",
    "pg": "8.22.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@types/node": "22.20.1",
    "@types/pg": "8.20.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "typescript": "5.9.3",
    "vite": "^8.1.5",
    "vitest": "4.1.10"
  },
  "files": [
    "build",
    "dist",
    "package.json"
  ]
}
