{
  "name": "@sdar/pms-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "contract:generate": "node scripts/generate-contract-types.mjs",
    "contract:check": "node scripts/check-contract-types.mjs",
    "validate:architecture": "node scripts/validate-architecture.mjs",
    "validate:pages": "node scripts/validate-page-completion.mjs",
    "lint": "node scripts/lint.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "npm run validate:architecture && npm run validate:pages && npm run check:imports && vitest run",
    "test:e2e": "playwright test",
    "build": "npm run contract:check && npm run validate:architecture && npm run validate:pages && npm run check:imports && npm run typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "check:imports": "node scripts/check-relative-imports.mjs"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "@tanstack/react-query": "^5.90.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "jsdom": "^30.0.0",
    "vite": "^8.1.5",
    "vitest": "^3.2.4",
    "typescript": "^5.9.3",
    "openapi-typescript": "^7.13.0",
    "@types/node": "^22.15.3"
  }
}
