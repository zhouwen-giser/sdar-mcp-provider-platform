# Repeat for device A/B, using their actual GOWM world-object and binding identities.
SMPP_STORAGE_MODE=gowm-shared
GOWM_DATABASE_URL_FILE=/run/secrets/gowm-smpp-database-url
SMPP_SERVICE_KEY=smpp-ugv
SMPP_ALLOWED_DEVICE_IDS=["REPLACE_WITH_DEVICE_A_WORLD_OBJECT_ID"]
SMPP_GOWM_BINDING_ID=REPLACE_WITH_DEVICE_A_BINDING_UUID
# Stable identity for this configured ingress connection; not a device boot epoch.
SMPP_SOURCE_SESSION_KEY=ugv-a-mqtt-connection
SMPP_GOWM_CONTRACT_DIR=contracts/gowm-shared-storage/current
PROVIDER_ID=REPLACE_WITH_BOUND_PROVIDER_ID
UGV_RESOURCE_ID=REPLACE_WITH_BOUND_RESOURCE_ID
UGV_ENTITY_ID=REPLACE_WITH_DEVICE_MESSAGE_ENTITY_ID
UGV_EXECUTION_MODE=simulation
UGV_ADAPTER_STORE_MODE=postgres
# Optional settings file; task-business stays disabled until source, store and Runtime methods are wired.
# UGV_TASK_BUSINESS_PROFILE_PATH=examples/gowm-shared-storage/task-business-profile.example.json
ADAPTER_ENDPOINT=127.0.0.1:7101
ADAPTER_PORT=7101
PORT=8101
# Explicit software Device MCP / isolated MQTT endpoints for development.
UGV_DEVICE_MCP_URL=http://127.0.0.1:9101/mcp
UGV_MQTT_URL=mqtt://127.0.0.1:18831

# Optional existing airport planner, only with the inspected ugv1 software scene.
# Install both packaged GOWM Runtime 027 and Provider 030 overlays before enabling.
# UGV_ENTITY_ID=ugv1
# UGV_NAVIGATION_PLANNER_MODE=isr_airport
# UGV_NAVIGATION_PLANNER_URL=http://192.168.2.63:7879
# UGV_TASK_BUSINESS_PROFILE_PATH=examples/gowm-shared-storage/task-business-airport-navigation.example.json
UGV_FIRE_ENABLED=false
