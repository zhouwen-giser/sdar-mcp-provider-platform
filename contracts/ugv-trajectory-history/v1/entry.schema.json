{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "sequence": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,18})$"
    },
    "previousHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "receipt": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "string",
          "const": "ugv.trajectory-reception/1.0"
        },
        "receptionId": {
          "type": "string",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "sessionId": {
          "type": "string",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "sourceTopic": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "originalMessageSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "originalMessageBytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "originalMessageReference": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "providerReceivedAt": {
          "type": "object",
          "properties": {
            "utc": {
              "type": "string",
              "format": "date-time",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
            },
            "owner": {
              "type": "string",
              "const": "PROVIDER_MQTT_MESSAGE_CALLBACK"
            },
            "clockId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "resolution": {
              "type": "string",
              "const": "MILLISECOND"
            },
            "synchronization": {
              "type": "string",
              "const": "UNVERIFIED"
            },
            "accuracyBoundMilliseconds": {
              "type": "null"
            },
            "processMonotonicNanoseconds": {
              "type": "string",
              "pattern": "^[0-9]+$"
            }
          },
          "required": [
            "utc",
            "owner",
            "clockId",
            "resolution",
            "synchronization",
            "accuracyBoundMilliseconds",
            "processMonotonicNanoseconds"
          ],
          "additionalProperties": false
        },
        "reportedTime": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "originalField": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                "rawValueJson": {
                  "type": "string",
                  "maxLength": 4096
                },
                "valueProvenance": {
                  "type": "string",
                  "const": "DECODED_JSON_VALUE_NOT_ORIGINAL_WIRE_LEXEME"
                },
                "unit": {
                  "type": "string",
                  "enum": [
                    "ISO8601",
                    "EPOCH_MICROSECONDS",
                    "MICROSECONDS_UNSPECIFIED_EPOCH",
                    "ROS_SECONDS_NANOSECONDS",
                    "UNKNOWN"
                  ]
                },
                "timeBase": {
                  "type": "string",
                  "enum": ["REPORTED_UNIX_EPOCH", "UNKNOWN"]
                },
                "reportedClockOwner": {
                  "type": "string",
                  "const": "MESSAGE_PRODUCER_UNVERIFIED"
                },
                "normalizedUtc": {
                  "anyOf": [
                    {
                      "type": "string",
                      "format": "date-time",
                      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "conversion": {
                  "anyOf": [
                    {
                      "type": "string",
                      "maxLength": 512
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "calibration": {
                  "type": "null"
                },
                "quality": {
                  "type": "string",
                  "enum": [
                    "REPORTED_UNVERIFIED",
                    "UNKNOWN_TIMEBASE",
                    "INVALID",
                    "REPORTED_CLOCK_REGRESSION"
                  ]
                }
              },
              "required": [
                "originalField",
                "rawValueJson",
                "valueProvenance",
                "unit",
                "timeBase",
                "reportedClockOwner",
                "normalizedUtc",
                "conversion",
                "calibration",
                "quality"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "deviceAcquisitionTime": {
          "type": "null"
        },
        "deviceClockAttribution": {
          "type": "string",
          "const": "NOT_ATTESTED_BY_PRODUCER_CONTRACT"
        },
        "sourceReportedSequence": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 256
            },
            {
              "type": "null"
            }
          ]
        },
        "sourceProducerEpoch": {
          "type": "null"
        },
        "transport": {
          "type": "object",
          "properties": {
            "qos": {
              "type": "integer",
              "minimum": 0,
              "maximum": 2
            },
            "packetId": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 65535
                },
                {
                  "type": "null"
                }
              ]
            },
            "duplicateDeliveryHint": {
              "type": "boolean"
            },
            "retainedDelivery": {
              "type": "boolean"
            }
          },
          "required": ["qos", "packetId", "duplicateDeliveryHint", "retainedDelivery"],
          "additionalProperties": false
        },
        "disposition": {
          "type": "string",
          "enum": ["POSITION_OBSERVATION", "NO_POSITION", "REJECTED"]
        },
        "reasonCode": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "position": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "longitude": {
                  "type": "number",
                  "minimum": -180,
                  "maximum": 180
                },
                "latitude": {
                  "type": "number",
                  "minimum": -90,
                  "maximum": 90
                },
                "altitude": {
                  "type": "number"
                },
                "crs": {
                  "type": "string",
                  "const": "OGC:CRS84"
                },
                "derivation": {
                  "type": "string",
                  "const": "VERSIONED_PROVIDER_NORMALIZER"
                }
              },
              "required": ["longitude", "latitude", "crs", "derivation"],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "reportedMission": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "missionId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                "provenance": {
                  "type": "string",
                  "const": "SAME_ORIGINAL_MESSAGE"
                },
                "producerEpoch": {
                  "type": "null"
                },
                "executionOwnership": {
                  "type": "string",
                  "const": "NOT_ATTESTED"
                }
              },
              "required": ["missionId", "provenance", "producerEpoch", "executionOwnership"],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "evidenceClass": {
          "type": "string",
          "enum": ["SIMULATED", "UNQUALIFIED_SOURCE"]
        },
        "diagnostics": {
          "maxItems": 32,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        }
      },
      "required": [
        "schemaVersion",
        "receptionId",
        "sessionId",
        "sourceTopic",
        "originalMessageSha256",
        "originalMessageBytes",
        "originalMessageReference",
        "providerReceivedAt",
        "reportedTime",
        "deviceAcquisitionTime",
        "deviceClockAttribution",
        "sourceReportedSequence",
        "sourceProducerEpoch",
        "transport",
        "disposition",
        "reasonCode",
        "position",
        "reportedMission",
        "evidenceClass",
        "diagnostics"
      ],
      "additionalProperties": false
    },
    "recordedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    },
    "recordingClockOwner": {
      "type": "string",
      "const": "POSTGRESQL_RECORD_INSERTION_CLOCK"
    },
    "recordingResolution": {
      "type": "string",
      "const": "MICROSECOND"
    },
    "exactTransactionCommittedAt": {
      "type": "null"
    }
  },
  "required": [
    "sequence",
    "previousHash",
    "hash",
    "receipt",
    "recordedAt",
    "recordingClockOwner",
    "recordingResolution",
    "exactTransactionCommittedAt"
  ],
  "additionalProperties": false
}
