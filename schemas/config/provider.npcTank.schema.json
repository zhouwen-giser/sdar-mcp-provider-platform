    "NPC_TANK_MQTT_WIRE_MODE",
    "NPC_TANK_CHASSIS_FRESHNESS_MS",
    "NPC_TANK_MISSION_FRESHNESS_MS",
    "NPC_TANK_HEALTH_FRESHNESS_MS",
