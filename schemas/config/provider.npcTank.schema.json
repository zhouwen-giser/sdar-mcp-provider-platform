      "default": 500,
      "maximum": 9007199254740991,
      "minimum": 100,
      "type": "integer"
    },
    "NPC_TANK_MQTT_SESSION_MODE": {
      "default": "persistent",
      "enum": ["clean", "persistent"],
      "type": "string"
    },
    "NPC_TANK_MQTT_TLS_CA_PATH": { "type": "string" },
    "NPC_TANK_MQTT_TLS_CERT_PATH": { "type": "string" },
    "NPC_TANK_MQTT_TLS_KEY_PATH": { "type": "string", "writeOnly": true, "x-sdar-secretRef": true },
