    "NPC_TANK_DEVICE_MCP_CONTRACT_REPORT_PATH",
    "NPC_TANK_NAVIGATION_SELECTION_REPORT_PATH",
    "NPC_TANK_EO_SCAN_CAPABILITY_REPORT_PATH",
    "NPC_TANK_ALLOW_NAVIGATION_WITH_RECON",
    "NPC_TANK_FIRE_REQUIRES_CHASSIS_STOPPED",
    "NPC_TANK_EXECUTION_POLL_INTERVAL_MS",
    "PROVIDER_TELEMETRY_ENABLED",
    "PROVIDER_TELEMETRY_ENDPOINT",
    "PROVIDER_TELEMETRY_TLS_MODE",
    "RUNTIME_ENV",
    "ALLOW_INSECURE_INTERNAL_TRANSPORT",
    "LOG_LEVEL"
  ],
  "title": "provider.npcTank",
  "type": "object",
  "x-sdar-definition-version": 1
}
