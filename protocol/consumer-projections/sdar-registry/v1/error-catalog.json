      "retryable": false
    },
    {
      "code": "SDAR_REGISTRY_PROJECTION_NATIVE_SNAPSHOT_INVALID",
      "httpStatus": 500,
      "message": "The Registry snapshot cannot be projected safely",
      "retryable": false
    },
    {
      "code": "SDAR_REGISTRY_PROJECTION_TTL_INVALID",
      "httpStatus": 500,
      "message": "The Registry snapshot cannot be projected safely",
      "retryable": false
    }
