# Copy this file to .env. Replace every replace-* value before running up.sh.

# PMS Console secrets live in an absolute UID-1000-owned directory outside this repository.
# See ../pms-console/secrets/README.md for the required files and permissions.
PMS_CONSOLE_SECRET_ROOT=/absolute/path/outside/repository/sdar-pms-console-secrets

# PMS Web is the only public PMS service. API and Worker remain internal to Compose.
PMS_WEB_BIND_ADDRESS=127.0.0.1
PMS_WEB_PORT=8088
PMS_WEB_PROXY_MAX_BODY_BYTES=1048576
PMS_WEB_PROXY_TIMEOUT_MS=10000

# External real simulator endpoints. Use host.docker.internal for services on the Docker host,
# or use a routable LAN IP/DNS name. Do not put credentials in either URL.
UGV_SIM_DEVICE_MCP_URL=http://host.docker.internal:19000/mcp
UGV_SIM_DEVICE_MCP_HEADERS_FILE=
UGV_SIM_DEVICE_MCP_TLS_MODE=disabled
UGV_SIM_DEVICE_MCP_TIMEOUT_MS=10000

UGV_SIM_MQTT_URL=mqtt://host.docker.internal:1883
UGV_SIM_MQTT_USERNAME=
UGV_SIM_MQTT_PASSWORD_FILE=
UGV_SIM_MQTT_TLS_MODE=disabled
UGV_SIM_MQTT_TLS_CA_FILE=
UGV_SIM_MQTT_TLS_CERT_FILE=
UGV_SIM_MQTT_TLS_KEY_FILE=
UGV_SIM_MQTT_CLIENT_ID=sdar-real-ugv-adapter-ugv1

# Mandatory explicit envelope selected from a real passive sample. "auto" is forbidden.
# The supplied UGV bridge currently uses heterogeneous ROS JSON messages, so
# ros_bridge_json is the expected real profile unless a later capture proves otherwise.
UGV_MQTT_WIRE_MODE=replace-with-ros_bridge_json-or-another-captured-mode

# URL-safe, local qualification database passwords (16+ random characters recommended).
UGV_ADAPTER_DB_PASSWORD=replace-with-url-safe-local-password
UGV_RUNTIME_DB_PASSWORD=replace-with-different-url-safe-local-password

# Read-only preflight/smoke bounds.
UGV_PREFLIGHT_MQTT_CONNECT_TIMEOUT_MS=10000
UGV_PREFLIGHT_MQTT_SAMPLE_TIMEOUT_MS=20000
UGV_RUNTIME_PORT=19100
UGV_SMOKE_REQUEST_TIMEOUT_MS=10000
UGV_SMOKE_MAX_STATE_AGE_MS=30000
UGV_LOG_LEVEL=info
UGV_COMPOSE_WAIT_TIMEOUT_SECONDS=180

# Safety defaults. up.sh and smoke.sh never execute controls, even if a later qualification
# operator deliberately enables these switches for a separate control runner.
UGV_ENABLE_REAL_CONTROL=false
UGV_TEST_DISTANCE_M=1
UGV_TEST_SAFE_POINT_JSON=
UGV_TEST_SAFE_WAYPOINTS_JSON=
UGV_ENABLE_RECON_TESTS=false
UGV_TEST_RECON_REGION_JSON=
UGV_ENABLE_EFFECTOR_TESTS=false
