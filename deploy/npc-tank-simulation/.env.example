# Copy to deploy/npc-tank-simulation/.env. Never commit that file.
# All credential paths below must be absolute and outside this repository.

# Goal 10 PMS Console base secrets. See deploy/pms-console/secrets/README.md.
PMS_CONSOLE_SECRET_ROOT=/absolute/path/outside/repository/sdar-pms-console-secrets

# NPC overlay credentials for pms-api and pms-worker. This root contains management.json,
# runtime.json, and their token files, all referenced through
# /run/npc-pms-credentials/... paths inside the descriptors.
NPC_TANK_PMS_CREDENTIAL_ROOT=/absolute/path/outside/repository/npc-pms-credentials
PMS_WEB_BIND_ADDRESS=127.0.0.1
PMS_WEB_PORT=8089

# Real external simulator endpoints. Container loopback addresses are rejected.
NPC_TANK_SIM_DEVICE_MCP_URL=http://host.docker.internal:19003/mcp
NPC_TANK_SIM_DEVICE_MCP_HEADERS_FILE=
NPC_TANK_SIM_DEVICE_MCP_TLS_MODE=disabled
NPC_TANK_SIM_DEVICE_MCP_TIMEOUT_MS=10000

NPC_TANK_SIM_MQTT_URL=mqtt://host.docker.internal:1883
NPC_TANK_SIM_MQTT_CLIENT_ID=sdar-real-npc-tank-adapter-npc-tank1
NPC_TANK_SIM_MQTT_USERNAME=
NPC_TANK_SIM_MQTT_PASSWORD_FILE=
NPC_TANK_SIM_MQTT_TLS_MODE=disabled
NPC_TANK_SIM_MQTT_TLS_CA_FILE=
NPC_TANK_SIM_MQTT_TLS_CERT_FILE=
NPC_TANK_SIM_MQTT_TLS_KEY_FILE=

# Captured real broker payloads currently require this explicit compatibility
# mode. Goal 11 documents it as SIMULATOR_INTERFACE_DEFECT because the frozen
# qualification contract names only ros_message_json/direct_domain_json.
NPC_TANK_MQTT_WIRE_MODE=ros_bridge_json
NPC_TANK_DEVICE_MCP_ALLOW_MOCK_CONTRACT=false

# Separate database password and URL files prevent credentials from entering
# Compose environment/config output. Passwords must be 16+ characters and the
# URL password must be percent-encoded when needed.
NPC_TANK_ADAPTER_DB_PASSWORD_FILE=/absolute/path/outside/repository/npc-adapter-db-password
NPC_TANK_ADAPTER_DATABASE_URL_FILE=/absolute/path/outside/repository/npc-adapter-database-url
NPC_TANK_RUNTIME_DB_PASSWORD_FILE=/absolute/path/outside/repository/npc-runtime-db-password
NPC_TANK_RUNTIME_DATABASE_URL_FILE=/absolute/path/outside/repository/npc-runtime-database-url

NPC_TANK_RUNTIME_PORT=19103
NPC_TANK_ADAPTER_PORT=7013
NPC_TANK_LOG_LEVEL=info
NPC_TANK_PREFLIGHT_MQTT_CONNECT_TIMEOUT_MS=10000
NPC_TANK_PREFLIGHT_MQTT_SAMPLE_TIMEOUT_MS=20000

# Default qualification is strictly read-only. qualify.sh also requires an
# explicit CLI switch before it will even validate a mutating phase.
NPC_TANK_ENABLE_REAL_CONTROL=false
NPC_TANK_TEST_DISTANCE_M=1
NPC_TANK_TEST_SAFE_POINT_JSON=
NPC_TANK_TEST_SAFE_WAYPOINTS_JSON=
NPC_TANK_ENABLE_RECON_TESTS=false
NPC_TANK_TEST_RECON_REGION_JSON=
NPC_TANK_ENABLE_EFFECTOR_TESTS=false

# Set true only after formal PMS API onboarding and Worker reconciliation.
# When true, smoke.sh rejects the local Compose URL as final authority and uses
# the live Registry snapshot endpoint instead.
NPC_TANK_REQUIRE_PMS_REGISTRY=false
NPC_TANK_PMS_ENVIRONMENT=simulation
