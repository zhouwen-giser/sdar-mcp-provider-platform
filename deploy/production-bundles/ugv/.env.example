# User-editable deployment configuration. Image identity is not accepted here;
# bin/*.sh always load the bundle-generated .bundle-images.env last.

PMS_WEB_BIND_ADDRESS=0.0.0.0
PMS_WEB_PORT=8088
PMS_WEB_PROXY_MAX_BODY_BYTES=1048576
PMS_WEB_PROXY_TIMEOUT_MS=10000

UGV_RUNTIME_BIND_ADDRESS=0.0.0.0
UGV_RUNTIME_PORT=19100
# Registry publishes this base URL to intranet consumers. It must identify this
# host by a real LAN address or resolvable LAN name and must not end in /mcp.
UGV_RUNTIME_ADVERTISED_URL=http://REPLACE_WITH_UGV_RUNTIME_HOST:19100

# This package is intentionally restricted to a trusted, isolated intranet and
# explicitly opts in to plaintext transport and anonymous PMS/Runtime access.
# Database and internal Runtime registration credentials remain file-backed.
ALLOW_INSECURE_INTERNAL_TRANSPORT=true

UGV_SIM_DEVICE_MCP_URL=http://device-mcp.intranet.invalid/mcp
UGV_SIM_DEVICE_MCP_TIMEOUT_MS=10000

UGV_SIM_MQTT_URL=mqtt://mqtt.intranet.invalid:1883
UGV_SIM_MQTT_CLIENT_ID=sdar-production-ugv-adapter-ugv1

# Must be explicit. The current heterogeneous bridge uses ros_bridge_json, but
# that compatibility profile remains only partially qualified until upstream
# envelope and QoS drift is resolved.
UGV_MQTT_WIRE_MODE=ros_bridge_json

UGV_ADAPTER_DATABASE_POOL_MAX=8
UGV_RUNTIME_DATABASE_POOL_MAX=10
UGV_MQTT_RECONNECT_MIN_MS=500
UGV_MQTT_RECONNECT_MAX_MS=30000
UGV_CHASSIS_FRESHNESS_MS=3000
UGV_MISSION_FRESHNESS_MS=3000
UGV_HEALTH_FRESHNESS_MS=5000
UGV_TARGET_FRESHNESS_MS=3000
UGV_PAYLOAD_FRESHNESS_MS=3000
UGV_SMOKE_MAX_STATE_AGE_MS=30000
UGV_PMS_AUTHORITY_WAIT_TIMEOUT_MS=180000
UGV_PMS_AUTHORITY_POLL_INTERVAL_MS=2000
UGV_LOG_LEVEL=info
UGV_COMPOSE_WAIT_TIMEOUT_SECONDS=240
