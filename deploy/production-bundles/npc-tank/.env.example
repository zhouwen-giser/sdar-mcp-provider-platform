# Copy to .env and edit only deployment-specific, non-secret values.
# The immutable image identity is supplied separately by .bundle-images.env.

BUNDLE_STATE_ROOT=./state
COMPOSE_WAIT_TIMEOUT_SECONDS=240

# Required explicit acknowledgement for production processes using plain
# transport inside the isolated deployment network. Only the literal true is accepted.
ALLOW_INSECURE_INTERNAL_TRANSPORT=true

# These endpoints are directly reachable from the deployment host's internal
# interfaces. Restrict them to the trusted VLAN/subnet with the host firewall.
PMS_WEB_BIND_ADDRESS=0.0.0.0
PMS_WEB_PORT=8089
PMS_WEB_PROXY_MAX_BODY_BYTES=1048576
PMS_WEB_PROXY_TIMEOUT_MS=10000
NPC_TANK_RUNTIME_BIND_ADDRESS=0.0.0.0
NPC_TANK_RUNTIME_PORT=19103

# The deployment is intentionally restricted to an isolated internal network.
# Plain HTTP/MQTT are explicit policy; no TLS certificate or security gateway is
# required. Do not expose these endpoints to an untrusted network.
NPC_TANK_DEVICE_MCP_URL=http://REPLACE_WITH_REAL_DEVICE_MCP_HOST/mcp
NPC_TANK_DEVICE_MCP_TIMEOUT_MS=10000

NPC_TANK_MQTT_URL=mqtt://REPLACE_WITH_REAL_MQTT_HOST:1883
NPC_TANK_MQTT_CLIENT_ID=sdar-production-npc-tank1

# These values bind JWTs accepted by the Runtime. The signing secret is generated
# by bin/init.sh and is never stored in this file.
NPC_TANK_RUNTIME_JWT_ISSUER=sdar-npc-tank-production
NPC_TANK_RUNTIME_JWT_AUDIENCE=sdar-runtime
NPC_TANK_LOG_LEVEL=info
