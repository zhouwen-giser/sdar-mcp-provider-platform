# Copy this file to .env. Never place credentials or tokens in this file.
# The secret root must be an absolute directory outside this repository.
PMS_CONSOLE_SECRET_ROOT=/absolute/path/outside/repository/sdar-pms-console-secrets

# pms-web is browser-facing; pms-api remains internal to the Compose network.
PMS_WEB_BIND_ADDRESS=127.0.0.1
PMS_WEB_PORT=8088
PMS_WEB_PROXY_MAX_BODY_BYTES=1048576
PMS_WEB_PROXY_TIMEOUT_MS=10000

PMS_COMPOSE_WAIT_TIMEOUT_SECONDS=180
