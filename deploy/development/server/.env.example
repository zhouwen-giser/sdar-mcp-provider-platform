# 仅隔离纯软件仿真网络；所有阶段免调用凭证。修改任意项后重新运行 up。
# 不含真实凭据。数据库默认密码仅开发用途；同时修改对应 DATABASE_URL。
# RUNTIME__/ADAPTER__ 是目标服务前缀，启动时去除；注释项不传入进程。

# 部署参数 DEPLOY_PROJECT；默认 smpp-development；阶段可选 development_debug/integration_candidate/qualification。
DEPLOY_PROJECT=smpp-development

# 部署参数 DEPLOY_BIND_ADDRESS；默认 0.0.0.0；阶段可选 development_debug/integration_candidate/qualification。
DEPLOY_BIND_ADDRESS=0.0.0.0

# 部署参数 DEPLOY_PORT；默认 19100；阶段可选 development_debug/integration_candidate/qualification。
DEPLOY_PORT=19100

# 部署参数 DEPLOY_STAGE；默认 development_debug；阶段可选 development_debug/integration_candidate/qualification。
DEPLOY_STAGE=development_debug

# 部署参数 DEPLOY_WAIT_SECONDS；默认 180；阶段可选 development_debug/integration_candidate/qualification。
DEPLOY_WAIT_SECONDS=180

# 部署参数 POSTGRES_IMAGE；默认 postgres:17-alpine；阶段可选 development_debug/integration_candidate/qualification。
POSTGRES_IMAGE=postgres:17-alpine

# 部署参数 NODE_BASE_IMAGE；默认 node:22-bookworm-slim；阶段可选 development_debug/integration_candidate/qualification。
NODE_BASE_IMAGE=node:22-bookworm-slim

# RUNTIME ADAPTER_ENDPOINT；规则 {"type":"string"}；重启生效。
RUNTIME__ADAPTER_ENDPOINT="adapter:7010"

# RUNTIME ADAPTER_HEALTH_FAILURE_THRESHOLD；规则 {"default":2,"maximum":10,"minimum":1,"type":"integer"}；重启生效。
RUNTIME__ADAPTER_HEALTH_FAILURE_THRESHOLD="2"

