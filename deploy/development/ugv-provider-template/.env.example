# Default Development Debug profile. Copy to .env only when local overrides are needed.
# It connects to the shared remote simulator and enables every registered tool side effect.

UGV_DELIVERY_STAGE=development_debug
UGV_TEMPLATE_EXECUTION_MODE=live
UGV_SIM_DEVICE_MCP_URL=http://192.168.2.63:19000/mcp
UGV_SIM_DEVICE_MCP_TIMEOUT_MS=5000
UGV_SIM_MQTT_URL=mqtt://192.168.2.63:1883
UGV_SIM_MQTT_CLIENT_ID=sdar-development-ugv-adapter
UGV_MQTT_WIRE_MODE=ros_bridge_json
UGV_FIRE_ENABLED=true

# These are conspicuous development-only values, not production credentials.
UGV_ADAPTER_DB_PASSWORD=development-adapter-only
UGV_RUNTIME_DB_PASSWORD=development-runtime-only

UGV_TEMPLATE_ADAPTER_PORT=17010
UGV_TEMPLATE_RUNTIME_PORT=19120
UGV_TEMPLATE_MOCK_DEVICE_PORT=19020
UGV_TEMPLATE_MOCK_MQTT_PORT=18830
UGV_TEMPLATE_WAIT_TIMEOUT_SECONDS=180
UGV_LOG_LEVEL=info

# Startup preflight remains read-only; Runtime MCP calls may use every tool after startup.
UGV_PREFLIGHT_MQTT_CONNECT_TIMEOUT_MS=10000
UGV_PREFLIGHT_MQTT_SAMPLE_TIMEOUT_MS=20000
UGV_SMOKE_REQUEST_TIMEOUT_MS=10000
UGV_SMOKE_MAX_STATE_AGE_MS=30000
UGV_ENABLE_REAL_CONTROL=true
UGV_ENABLE_RECON_TESTS=true
UGV_ENABLE_EFFECTOR_TESTS=true
