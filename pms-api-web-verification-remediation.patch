@@ -1,3 +1,13 @@
 import react from "@vitejs/plugin-react";
-import { defineConfig } from "vitest/config";
-export default defineConfig({plugins:[react()],test:{environment:"jsdom",setupFiles:[],restoreMocks:true}});
+
+// Keep this as a plain config object because the locked Vitest and Vite majors expose
+// structurally incompatible Plugin types even though Vitest accepts the Vite plugin at runtime.
+export default {
+  plugins: [react()],
+  test: {
+    environment: "jsdom",
+    setupFiles: [],
+    restoreMocks: true,
+    exclude: ["e2e/**", "node_modules/**", "dist/**"],
+  },
+};
