+        ),
+      "MQTT_SUBSCRIPTION_GRANT_SET_MISMATCH",
+    );
+    expectQualificationCode(
+      () =>
+        validateExactMqttSubscriptionGrants(
+          [{ topic: "/ugv/status", qos: 0 }, expected[1]],
+          expected,
+        ),
+      "MQTT_SUBSCRIPTION_QOS_REJECTED",
+    );
+  });
+
