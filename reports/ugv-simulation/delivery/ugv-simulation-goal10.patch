+    deviceMcpUrl,
+    deviceMcpHeaders: loadedHeaders.headers,
+    deviceMcpTimeoutMs: boundedInteger(
+      env.UGV_SIM_DEVICE_MCP_TIMEOUT_MS,
+      "UGV_SIM_DEVICE_MCP_TIMEOUT_MS",
