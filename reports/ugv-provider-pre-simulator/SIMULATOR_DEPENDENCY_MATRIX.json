      "fields": [
        "entity_id",
        "latitude",
        "longitude",
        "altitude",
        "heading",
        "source time/sequence"
      ]
    },
    { "topic": "/ugv/speed", "fields": ["entity_id", "speed_kmh", "source time/sequence"] },
