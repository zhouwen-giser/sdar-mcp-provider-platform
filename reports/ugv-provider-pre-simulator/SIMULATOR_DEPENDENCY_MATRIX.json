    {
      "name": "ugv_area_recon_configure",
      "kind": "mutating",
      "expect": ["accepted/rejected", "mission_id or run_id"]
    },
    {
      "name": "ugv_area_recon_control",
      "kind": "mutating",
      "expect": ["action", "mission_id or run_id", "accepted/rejected"]
