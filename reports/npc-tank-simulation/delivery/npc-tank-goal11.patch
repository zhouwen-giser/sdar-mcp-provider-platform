+      status: mqtt.compositeStatusObserved
+        ? mqtt.publisherQosDrift.length === 0 && inferWireMode(mqtt.samples) !== "ros_bridge_json"
+          ? "PASS"
+          : "PASS_WITH_UPSTREAM_DRIFT"
