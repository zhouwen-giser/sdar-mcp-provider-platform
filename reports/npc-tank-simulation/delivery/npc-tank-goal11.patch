+  const runtimeConfig = arrayOrEmpty(runtime.runtimeConfig, "PMS_RUNTIME_DESCRIPTOR_INVALID");
+  const runtimeRegistration = arrayOrEmpty(
+    runtime.runtimeRegistration,
+    "PMS_RUNTIME_DESCRIPTOR_INVALID",
+  );
