+    --format '{{ index .Config.Labels "org.opencontainers.image.revision" }}' "$image")" || \
+    blocked "qualified image is missing: $image"
+  [[ "$revision" == "$NPC_TANK_QUALIFICATION_GIT_SHA" ]] || \
