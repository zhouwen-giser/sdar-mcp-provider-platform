+services:
+  # This is an overlay only. The PMS service definition remains authoritative in
+  # deploy/pms-console/compose.yaml; this adds externally scoped credentials.
+  pms-api:
+    environment:
+      PMS_MANAGEMENT_CREDENTIAL_FILE: /run/npc-pms-credentials/management.json
+      PMS_RUNTIME_CREDENTIAL_FILE: /run/npc-pms-credentials/runtime.json
+    volumes:
+      - type: bind
+        source: ${NPC_TANK_PMS_CREDENTIAL_ROOT:?NPC_TANK_PMS_CREDENTIAL_ROOT is required}
+        target: /run/npc-pms-credentials
+        read_only: true
+
+  # The onboarding command runs in Worker because only Worker owns database
+  # provisioning and PM2 Runtime state. The same scoped descriptors are
+  # mounted read-only so no credential text enters Compose environment data.
