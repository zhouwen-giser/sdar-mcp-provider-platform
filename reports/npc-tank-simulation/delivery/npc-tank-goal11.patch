+      subscriptionGrants: mqtt.subscriptionGrants,
+      topics: TOPICS.map((topic) => {
+        const sample = mqtt.samples.find((candidate) => candidate.topic === topic);
+        return {
+          topic,
+          expectedQos: qos(topic),
