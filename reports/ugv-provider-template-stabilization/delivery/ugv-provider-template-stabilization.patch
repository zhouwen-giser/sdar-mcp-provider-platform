+    execution: "SYNCHRONOUS",
+    tracks: [],
+    phases: { read: requiredTools(toolName) },
+    resultPolicy: resultPolicy(`ugv.${operationName}.v1`),
+    observationPolicy: { requiredFreshnessDomains },
