+  field: NonNullable<PhysicalObservationAuthority["field"]>,
+): PhysicalObservationAuthority {
+  const value = values.find((authority) => authority.field === field);
+  if (value === undefined) throw new Error("UGV_TEST_AUTHORITY_MISSING");
+  return value;
+}
